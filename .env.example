# ==============================================================================
# LibreChat & Code Interpreter Sandbox Hardening
# 環境変数テンプレート (.env.example)
#
# 【利用方法】
# 本ファイルをコピーして .env を作成し、環境に合わせて値を設定してください。
#   $ cp .env.example .env
# ==============================================================================

# ==============================================================================
# 1. ネットワーク・ドメイン設定
# ==============================================================================
# ドメイン名（SSL証明書のCN/SANおよびNginxのserver_nameと一致させること）
DOMAIN=librechat.example.com

# Nginx 公開ポート設定
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ==============================================================================
# 2. LibreChat 認証 & セキュリティ設定
# ==============================================================================
# ポート番号（コンテナ内部）
LIBRECHAT_PORT=3080

# 署名・暗号化シークレット（※本番環境ではランダムな安全な文字列に変更してください）
JWT_SECRET=Secret_Enterprise_JWT_Key_2026_Secure
JWT_REFRESH_SECRET=Secret_Enterprise_JWT_Refresh_Key_2026_Secure
CREDS_KEY=f34fa21345129ef9982a173c38d6139d89ab5794821a71918a38b1d3d6e52467
CREDS_IV=a87f4c919d38102a110293847a908f12

# 設定ファイルバリデーションバイパス（カスタム設定の柔軟な読み込み用）
CONFIG_BYPASS_VALIDATION=true

# ユーザー登録・認証制御
ALLOW_REGISTRATION=true
ALLOW_EMAIL_LOGIN=true
ALLOW_UNVERIFIED_EMAIL_LOGIN=true
ALLOW_PASSWORD_RESET=false
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false

# セッション有効期限（ミリ秒）
SESSION_EXPIRY=86400000          # 24時間
REFRESH_TOKEN_EXPIRY=2592000000  # 30日

# クライアント・サーバー URL 設定 (Nginx SSL URL と一致)
DOMAIN_CLIENT=https://librechat.example.com
DOMAIN_SERVER=https://librechat.example.com

# ==============================================================================
# 3. 外部・社内 LLM API 設定 (さくらインターネットAI / OpenAI互換等)
# ==============================================================================
# さくらインターネット AI 高火力 API (または社内OpenAI互換プロキシ)
EXTERNAL_API_URL=https://api.ai.sakura.ad.jp/v1/
EXTERNAL_API_KEY=your_sakura_or_openai_api_key_here
EXTERNAL_LLM_MODEL=preview/Qwen3.6-35B-A3B

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI 公式 API / 社内プロキシ
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_REVERSE_PROXY=https://your-proxy.internal.domain/v1

# Anthropic Claude API
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Azure OpenAI
# AZURE_API_KEY=your_azure_api_key
# AZURE_OPENAI_DEFAULT_MODEL=gpt-4o
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# ローカル LLM (Ollama / LiteLLM Proxy)
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# LITELLM_BASE_URL=http://litellm-proxy:4000

# ==============================================================================
# 4. Code Interpreter & Worker Sandbox (RCE) 連携設定
# ==============================================================================
# LibreChat → Code API Gateway 接続 (ポート8000)
LIBRECHAT_CODE_BASEURL=http://code-api:3112
LIBRECHAT_CODE_API_KEY=Internal_Enterprise_RCE_Secret_Key_2026

# Code API Gateway 設定
CODE_API_PORT=3112
CODEAPI_API_KEY=Internal_Enterprise_RCE_Secret_Key_2026

# サンドボックス実行制限 (NsJail)
MAX_EXECUTION_TIME=30
MAX_MEMORY_MB=1024
SESSION_TTL_HOURS=24

# Workerリソース制限 (cgroups)
WORKER_CPU_LIMIT=2.0
WORKER_MEMORY_LIMIT=2048M
WORKER_PIDS_LIMIT=50

# ==============================================================================
# 5. サンドボックス実行モード設定 (KVM vs NsJail Direct)
# ==============================================================================
# KVM / ネスト仮想化が有効な環境（推奨: MicroVMによる最高水準の隔離）:
#   KVM_ENABLED=true
#
# クラウドVM等で /dev/kvm が存在しない環境（NsJail 直接隔離モード）:
#   KVM_ENABLED=false
#   ※ KVM無効時は docker-compose.yml の sandbox-runner で devices を無効化し privileged: true を付与します。
KVM_ENABLED=true
KVM_DEVICE_PATH=/dev/kvm
SANDBOX_USE_CGROUPV2=true
SANDBOX_MAX_PROCESS_COUNT=100
SANDBOX_RUN_CPU_TIME=10000
SANDBOX_RUN_TIMEOUT=15000
SANDBOX_OUTPUT_MAX_SIZE=65536
SANDBOX_LOG_LEVEL=INFO

# 並列処理設定
PYTHON_CONCURRENCY=5
OTHER_CONCURRENCY=15
JOB_WINDOW=1000

# ==============================================================================
# 5. データベース & キャッシュ設定
# ==============================================================================
# MongoDB
MONGO_URI=mongodb://mongodb:27017/LibreChat
MONGO_INITDB_DATABASE=LibreChat

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=Secure_Redis_Password_54321

# ==============================================================================
# 6. オブジェクトストレージ設定 (MinIO / S3互換)
# ==============================================================================
MINIO_ROOT_USER=enterprise_rce_admin
MINIO_ROOT_PASSWORD=Secure_Encrypted_Minio_Password_98765
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=code-interpreter-files
MINIO_USE_SSL=false
MINIO_CONSOLE_PORT=9001

# Code API からの S3 接続設定
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=enterprise_rce_admin
S3_SECRET_KEY=Secure_Encrypted_Minio_Password_98765
S3_BUCKET=code-interpreter-files
S3_SECURE=false

# ==============================================================================
# 7. ファイルアップロード制限設定
# ==============================================================================
FILE_UPLOAD_MAX_SIZE=100
AVATAR_UPLOAD_MAX_SIZE=2
